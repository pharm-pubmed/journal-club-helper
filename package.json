{
  "name": "journal-club-helper",
  "private": true,
  "version": "0.3.0",
  "description": "Critical appraisal workflow for PubMed abstracts",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "prepare": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:live": "JCH_LIVE=1 playwright test",
    "check:manifest": "node scripts/check-manifest.mjs",
    "icons": "node scripts/make-icons.mjs",
    "site": "node scripts/build-site.mjs",
    "store:assets": "node scripts/make-icons.mjs && wxt build && playwright test --config store/playwright.config.ts capture.spec.ts && node scripts/build-site.mjs",
    "store:video": "wxt build && playwright test --config store/playwright.config.ts demo.spec.ts"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.2.9",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.14",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  }
}
