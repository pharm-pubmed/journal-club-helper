{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest",
        "--categoryExtensions",
        "--isolated",
        "--executablePath",
        "${JCH_CHROME_PATH:-/usr/bin/google-chrome}"
      ],
      "env": {}
    }
  }
}
