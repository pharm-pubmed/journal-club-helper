{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/require-green-checks.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking CI before merge"
          }
        ]
      }
    ]
  }
}
